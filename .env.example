HOST=127.0.0.1
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
DB_NAME=insurance_assessment
# Required before exposing the service beyond your computer:
# API_KEY=replace-with-a-random-secret-of-at-least-16-characters
CPU_THRESHOLD=70
CPU_INTERVAL_MS=1000
SCHEDULER_INTERVAL_MS=1000
MAX_IMPORT_WORKERS=2
UPLOAD_DIR=./work/uploads

# npm run local only: fixed port and durable data folder
LOCAL_MONGO_PORT=27017
LOCAL_DATA_DIR=./work/mongodb
