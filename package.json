{
  "name": "insurance-policy-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Worker-thread insurance import API and durable message scheduler",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/supervisor.js",
    "dev": "node --env-file=.env src/supervisor.js",
    "test": "node --test --test-concurrency=1",
    "check": "node scripts/check.js",
    "audit": "npm audit --omit=dev",
    "demo": "node scripts/demo.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "local": "node --env-file-if-exists=.env scripts/local.js"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "mongodb": "^7.6.0",
    "multer": "^2.4.0",
    "read-excel-file": "^9.3.10",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "write-excel-file": "^4.1.1"
  }
}
